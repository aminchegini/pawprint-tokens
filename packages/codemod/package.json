{
  "name": "@paws/codemod",
  "version": "0.1.0",
  "description": "Rewrites legacy design-token names to semantic ones in CSS, JS and TS, and counts what is left.",
  "license": "MIT",
  "author": "Amin Chegini",
  "type": "module",
  "bin": {
    "paws-codemod": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "postcss": "^8.5.32",
    "postcss-value-parser": "^4.2.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
